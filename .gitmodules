[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "exoplanetdata"]
	path = exoplanetdata
	url = https://github.com/moderndive/exoplanetdata
[submodule "moderndive"]
	path = moderndive
	url = https://github.com/moderndive/moderndive
[submodule "nycflights23"]
	path = nycflights23
	url = https://github.com/moderndive/nycflights23
[submodule "steves"]
	path = steves
	url = https://github.com/moderndive/steves
[submodule "volcanoes"]
	path = volcanoes
	url = https://github.com/moderndive/volcanoes
